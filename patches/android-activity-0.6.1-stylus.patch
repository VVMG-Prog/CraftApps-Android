+    /// Record the stylus data of this event.
+    ///
+    /// ANDROID-PORT (CraftApps): the app cannot see the motion event itself
+    /// (winit owns the input queue and drops the stylus data), so the tool
+    /// type and the button state are recorded here on the way past.
+    pub(crate) fn record_stylus_state(&self) {
+        let action_button = u32::from(self.action_button());
+        // The raw action: Samsung's S Pen replaces it with a proprietary
+        // variant while its side button is held.
+        let raw_action =
+            unsafe { ndk_sys::AMotionEvent_getAction(self.ndk_event.ptr().as_ptr()) as i32 }
+                & ndk_sys::AMOTION_EVENT_ACTION_MASK as i32;
+        let mut buttons = self.button_state().0;
+        if crate::input::samsung_pen_button_action(raw_action) {
+            // The tablet reports the button through the action, not through
+            // the button bits: report it the standard way, so the app can
+            // read it like any other stylus button.
+            buttons |= ndk_sys::AMOTION_EVENT_BUTTON_STYLUS_PRIMARY;
+        }
+        // A button-only event (ACTION_BUTTON_PRESS) has no pointer: the
+        // button state still matters, but there is no tool type or position.
+        if self.pointer_count() == 0 {
+            crate::input::record_stylus_state(&crate::input::StylusState {
+                buttons,
+                tool_type: 0,
+                action: u32::from(self.action()) as i32,
+                action_button,
+                x: 0.0,
+                y: 0.0,
+            });
+            return;
+        }
+        let pointer = self.pointer_at_index(0);
+        crate::input::record_stylus_state(&crate::input::StylusState {
+            buttons,
+            tool_type: u32::from(pointer.tool_type()) as i32,
+            action: u32::from(self.action()) as i32,
+            action_button,
+            x: pointer.x(),
+            y: pointer.y(),
+        });
+    }
+
