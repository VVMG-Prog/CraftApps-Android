diff -ruN a/src/input/stylus.rs b/src/input/stylus.rs
--- a/src/input/stylus.rs	1969-12-31 18:00:00.000000000 -0600
+++ b/src/input/stylus.rs	2026-10-19 21:45:22.270383404 -0500
@@ -0,0 +1,134 @@
+//! The stylus data of the most recent motion event.
+//!
+//! ANDROID-PORT (CraftApps): the app never sees the `MotionEvent` itself —
+//! winit owns the input queue and drops the stylus data (the tool type and
+//! the barrel-button state) — so it is recorded here as the events pass by,
+//! and the app reads it with [`stylus_state`].
+//!
+//! The data is the same the Java API exposes: `MotionEvent.getButtonState()`
+//! (the `BUTTON_STYLUS_*` bits) and `MotionEvent.getToolType()`.
+
+use std::sync::Mutex;
+
+/// The stylus data of the most recent motion event.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct StylusState {
+    /// The `MotionEvent.getButtonState()` bits. A stylus' side button sets
+    /// `BUTTON_STYLUS_PRIMARY` (`1 << 5`) or `BUTTON_STYLUS_SECONDARY`
+    /// (`1 << 6`).
+    pub buttons: u32,
+    /// The `MotionEvent.getToolType()` of the event's first pointer:
+    /// 0 unknown, 1 finger, 2 stylus, 3 mouse, 4 eraser, 5 palm.
+    pub tool_type: i32,
+    /// The action of the event: 0 down, 1 up, 2 move, 3 cancel.
+    pub action: i32,
+    /// The `MotionEvent.getActionButton()` bits: which button changed in a
+    /// button press or release event.
+    pub action_button: u32,
+    /// The position of the event's first pointer, in pixels.
+    pub x: f32,
+    /// The position of the event's first pointer, in pixels.
+    pub y: f32,
+}
+
+/// How many stylus events are kept before the oldest are dropped.
+const QUEUE_LIMIT: usize = 256;
+
+static QUEUE: Mutex<Vec<StylusState>> = Mutex::new(Vec::new());
+
+/// The stylus data of the motion events since the last call, oldest first.
+///
+/// ANDROID-PORT (CraftApps): the events are queued rather than sampled, so a
+/// quick button press and release cannot slip through between two frames.
+pub fn drain_stylus_states() -> Vec<StylusState> {
+    let mut queue = QUEUE.lock().unwrap_or_else(|poison| poison.into_inner());
+    std::mem::take(&mut *queue)
+}
+
+/// Record a stylus button that arrived as a key event
+/// (`KEYCODE_STYLUS_BUTTON_PRIMARY` and friends).
+///
+/// ANDROID-PORT (CraftApps): translated into the same protocol as the motion
+/// events, so the app reads the button the same way either way.
+pub(crate) fn record_stylus_button_key(key_code: i32, pressed: bool) {
+    let Some(button) = stylus_button_key(key_code) else { return };
+    let (x, y) = last_position();
+    record_stylus_state(&StylusState {
+        buttons: if pressed { button } else { 0 },
+        tool_type: 0,
+        action: if pressed { 11 } else { 12 }, // ACTION_BUTTON_PRESS / _RELEASE
+        action_button: button,
+        x,
+        y,
+    });
+}
+
+/// The last position the stylus reported.
+fn last_position() -> (f32, f32) {
+    let queue = QUEUE.lock().unwrap_or_else(|poison| poison.into_inner());
+    queue
+        .iter()
+        .rev()
+        .find(|state| state.tool_type != 0)
+        .map_or((0.0, 0.0), |state| (state.x, state.y))
+}
+
+/// Record the stylus data of a motion event (called by the input layer).
+pub(crate) fn record_stylus_state(state: &StylusState) {
+    let mut queue = QUEUE.lock().unwrap_or_else(|poison| poison.into_inner());
+    if queue.len() >= QUEUE_LIMIT {
+        // The app is not draining: drop the oldest events rather than grow.
+        queue.remove(0);
+    }
+    queue.push(*state);
+}
+
+/// Samsung's S Pen reports its side button by *replacing* the motion action
+/// with a proprietary variant instead of setting the button bits:
+///
+/// | action | meaning                    |
+/// |--------|----------------------------|
+/// | 211    | down, with the button held |
+/// | 213    | move, with the button held |
+/// | 212    | up, with the button held   |
+/// | 214    | cancel, with the button held |
+///
+/// The NDK has no name for those, so they arrive as `MotionAction::__Unknown`
+/// and a consumer that only knows the standard actions drops the event — the
+/// stroke stops while the button is held. Map them back to the standard
+/// actions; the button state itself is read from the event's button bits, or
+/// — on the tablets that only report the action — from the action itself
+/// (see [`samsung_pen_button_action`]).
+pub(crate) fn normalize_action(action: i32) -> i32 {
+    match action {
+        211 => 0, // AMOTION_EVENT_ACTION_DOWN
+        212 => 1, // AMOTION_EVENT_ACTION_UP
+        213 => 2, // AMOTION_EVENT_ACTION_MOVE
+        214 => 3, // AMOTION_EVENT_ACTION_CANCEL
+        other => other,
+    }
+}
+
+/// Is this one of Samsung's "the side button is held" actions?
+pub(crate) fn samsung_pen_button_action(action: i32) -> bool {
+    matches!(action, 211 | 212 | 213 | 214)
+}
+
+/// Android's `KEYCODE_STYLUS_BUTTON_PRIMARY` / `_SECONDARY`.
+///
+/// Android 14 and later report the stylus' side buttons as key events too.
+/// That is the only report a button press *while the pen hovers* produces on
+/// some devices (there is no touch event then), so it is translated into the
+/// same protocol as the motion events: an `ACTION_BUTTON_PRESS` /
+/// `_RELEASE` with the matching button.
+pub(crate) const KEYCODE_STYLUS_BUTTON_PRIMARY: i32 = 308;
+pub(crate) const KEYCODE_STYLUS_BUTTON_SECONDARY: i32 = 309;
+
+/// The button bits of a stylus button key code, if it is one.
+pub(crate) fn stylus_button_key(key_code: i32) -> Option<u32> {
+    match key_code {
+        KEYCODE_STYLUS_BUTTON_PRIMARY => Some(ndk_sys::AMOTION_EVENT_BUTTON_STYLUS_PRIMARY),
+        KEYCODE_STYLUS_BUTTON_SECONDARY => Some(ndk_sys::AMOTION_EVENT_BUTTON_STYLUS_SECONDARY),
+        _ => None,
+    }
+}
